rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated AND authorized as Admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == "camilalima@studio.com"
      );
    }

    match /studios/{studioId} {
      // Public profile/settings documents read, admin write
      allow read: if true;
      allow write: if isAdmin();

      // Services collection: public read, admin write
      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // Gallery collection: public read, admin write
      match /gallery/{itemId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // BlockedSlots collection: public read (for slot calculations), admin write
      match /blockedSlots/{slotId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }

      // Settings sub-documents: public read, admin write
      match /info/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /settings/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /profile/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /policies/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /businessHours/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Appointments collection:
      // - Public can read and create (for slot availability and online booking)
      // - Updates and deletes are strictly restricted to authenticated Admin
      match /appointments/{appointmentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // Default deny catch-all for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
