rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to verify authorized admin user
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == "camilalima@studio.com"
      );
    }

    // Public read for gallery images and studio logo
    match /studios/{studioId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
